# Variables d'environnement pour les tests
PORT=5000

# Configuration MongoDB (utilise MongoDB Memory Server pour les tests)
MONGODB_URI=mongodb://localhost:27017/test

# Configuration JWT pour les tests
JWT_SECRET=test_secret_key_for_testing_only_do_not_use_in_production
JWT_EXPIRE=7d

# Configuration Cloudinary (mock pour les tests)
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_key
CLOUDINARY_API_SECRET=test_secret

# Configuration Email (mock pour les tests)
EMAIL_HOST=test.smtp.com
EMAIL_PORT=587
EMAIL_USER=test@test.com
EMAIL_PASS=test_password
EMAIL_FROM=test@test.com

# Configuration Frontend
FRONTEND_URL=http://localhost:3000

# Configuration Redis (optionnel pour les tests)
REDIS_PASSWORD=test_redis_password

# Mode test
NODE_ENV=test
